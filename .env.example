BOT_TOKEN=replace_with_telegram_bot_token

# INSTANCE 1 — local Linux monitor
INSTANCE_1_NAME=Local Linux monitor
INSTANCE_1_IP=localhost
INSTANCE_1_CHAT_ID=replace_with_local_host_chat_id
INSTANCE_1_KEY=
INSTANCE_1_SSH_USER=

# INSTANCE 2 — Linux EC2 over SSH
INSTANCE_2_NAME=Linux EC2 monitor
INSTANCE_2_IP=replace_with_linux_ec2_address
INSTANCE_2_CHAT_ID=replace_with_linux_host_chat_id
INSTANCE_2_KEY=/path/to/linux-monitor-key.pem
INSTANCE_2_SSH_USER=replace_with_linux_ssh_user
INSTANCE_2_OS=linux

# INSTANCE 3 — Windows EC2 database host; replace disk paths with the host's
# actual SQL data and log volume mount paths. C:\ is also monitored automatically.
INSTANCE_3_NAME=Windows database host
INSTANCE_3_IP=replace_with_windows_ec2_address
INSTANCE_3_CHAT_ID=replace_with_distinct_windows_host_chat_id
INSTANCE_3_KEY=/path/to/windows-monitor-key.pem
INSTANCE_3_SSH_USER=replace_with_windows_ssh_user
INSTANCE_3_OS=windows
INSTANCE_3_DISK_PATHS=D:\SQLData;E:\SQLLogs

# ─── OPTIONAL SECURITY IDENTITIES (per instance, opt-in) ──
# Network observations are only called "expected" when one of these identity
# settings is present AND the observed process/container/socket matches it.
# Leave every setting below unset (or delete these lines) to keep the defaults:
# the scanner then reports unresolved network items for review instead of
# assuming they are safe. Destinations are exact addresses or CIDRs separated by
# ';' and may carry an optional ':port'. They are re-checked on every scan, so a
# destination that changes stops matching and is reported for review again.
#
# UNCONFIGURED IS A DELIBERATE FAIL-SAFE: with none of these set, every socket
# is judged from the evidence alone, unresolved outbound connections and
# network-reachable unidentified listeners are reported as needs_review, and
# the authoritative risk is at least MEDIUM. No identity, destination, or trust
# is ever inferred, and a port, an ephemeral port, or a container name alone
# never makes an item expected.
#
# Which setting resolves which reported item (verify on the host itself; the
# bot only reads these values from its environment):
#   monitor bot outbound socket  -> SECURITY_BOT_EXE, SECURITY_BOT_SCRIPT,
#                                  SECURITY_BOT_USER
#   bot destination stopped matching -> SECURITY_BOT_HTTPS_DESTINATIONS
#   Tailscale client socket      -> SECURITY_TAILSCALED_EXE,
#                                  SECURITY_TAILSCALED_USER
#   Tailscale destination        -> SECURITY_TAILSCALED_HTTPS_DESTINATIONS
#   collector publication        -> SECURITY_OTEL_CONTAINER_NAME
#   collector image not pinned   -> SECURITY_OTEL_IMAGE_ID
#INSTANCE_1_SECURITY_BOT_EXE=/path/to/monitor_bot/venv/python
#INSTANCE_1_SECURITY_BOT_SCRIPT=/path/to/monitor_bot/monitor.py
#INSTANCE_1_SECURITY_BOT_USER=replace_with_bot_owner_user
#INSTANCE_1_SECURITY_BOT_HTTPS_DESTINATIONS=203.0.113.10;198.51.100.0/24
#INSTANCE_1_SECURITY_TAILSCALED_EXE=/usr/bin/tailscaled
#INSTANCE_1_SECURITY_TAILSCALED_USER=replace_with_tailscale_owner_user
#INSTANCE_1_SECURITY_TAILSCALED_HTTPS_DESTINATIONS=203.0.113.20
#INSTANCE_1_SECURITY_OTEL_CONTAINER_NAME=replace_with_otel_collector_container_name
#INSTANCE_1_SECURITY_OTEL_IMAGE_ID=replace_with_pinned_otel_image_id

CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90
REPORT_INTERVAL=30

# Optional. Directory for the bot's durable runtime state, currently only the
# Telegram update offset (telegram_offset.json, mode 0600, in a 0700 directory)
# that stops a command being executed twice after a restart. Leave it unset to
# use $XDG_STATE_HOME/monitor_bot, or ~/.local/state/monitor_bot when that is
# unset too. It is never written inside the project directory.
#MONITOR_BOT_STATE_DIR=/var/lib/monitor_bot

# Optional Bedrock analyzer configuration; replace placeholders only if used.
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_REGION=replace_with_aws_region
